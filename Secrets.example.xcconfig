// Copy this file to `Secrets.xcconfig` (gitignored) and fill in your key.
//
// Get a free USDA FoodData Central key at: https://fdc.nal.usda.gov/api-key-signup.html
// It arrives by email instantly. Free tier is 1,000 requests/hour.
//
// The app builds and runs fine without this key — barcode scanning via
// Open Food Facts needs no key at all. Only USDA text search is disabled.

USDA_API_KEY = your_key_here
